PORT=3001
NODE_ENV=production

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cashflow_wb
DB_USER=postgres
DB_PASSWORD=your_password

# JWT
JWT_SECRET=your_very_long_secret_key_here
JWT_EXPIRES_IN=7d

# Encryption key for storing WB tokens (32 chars)
ENCRYPTION_KEY=your_32_char_encryption_key_here
